{
    "name": "obelaw/ium-eam",
    "description": "IUM Employee Asset Management",
    "authors": [
        {
            "name": "Karim Mohamed",
            "email": "komicho1996@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Obelaw\\Ium\\Eam\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Obelaw\\Ium\\Eam\\Tests\\": "tests/"
        }
    },
    "require": {
        "laravel/framework": "^11.0|^12.0",
        "obelaw/ium": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "orchestra/testbench": "^10.9"
    },
    "suggest": {
        "obelaw/ium-wms": "Sync assets with WMS warehouse inventory"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obelaw\\Ium\\Eam\\Providers\\EamServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest"
    }
}